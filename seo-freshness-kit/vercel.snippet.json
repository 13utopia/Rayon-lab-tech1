{
  "functions": {
    "api/sitemap.js": { "includeFiles": "seo-freshness-kit/**" },
    "api/updates.js": { "includeFiles": "seo-freshness-kit/**" },
    "api/publish.js": { "includeFiles": "seo-freshness-kit/**" }
  },
  "crons": [
    {
      "path": "/api/publish",
      "schedule": "30 1 * * 2,5"
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ]
}
